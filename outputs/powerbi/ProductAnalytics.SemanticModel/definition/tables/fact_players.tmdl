table fact_players
	lineageTag: dac396ce-d6d4-5e7e-9ee2-25374ca8e237

	measure 'Players' =
			DISTINCTCOUNT(fact_players[userid])
		formatString: #,0
		displayFolder: Performance
		lineageTag: bd0b4afb-fadb-56f6-93a1-9bf566caf03f

	measure 'Total Rounds' =
			SUM(fact_players[sum_gamerounds])
		formatString: #,0
		displayFolder: Performance
		lineageTag: 0c419e33-e8b5-5a6b-ad48-9e92c7f761ce

	measure 'Mean Rounds' =
			DIVIDE([Total Rounds], [Players])
		formatString: #,0.0
		displayFolder: Performance
		lineageTag: 399c85f2-d312-5a9f-92c4-952d801ded8c

	measure 'Median Rounds' =
			MEDIAN(fact_players[sum_gamerounds])
		formatString: #,0.0
		displayFolder: Performance
		lineageTag: 7cf3f6d6-9012-5cf9-a8a0-116bcb94ce91

	measure 'D1 Retained' =
			SUM(fact_players[retention_1])
		formatString: #,0
		displayFolder: Performance
		lineageTag: 7bfbb6db-9ab8-5c81-a74a-3248a10e2db0

	measure 'D7 Retained' =
			SUM(fact_players[retention_7])
		formatString: #,0
		displayFolder: Performance
		lineageTag: 06edab93-bd7f-57fc-a0e6-54b899cfe916

	measure 'D1 Retention' =
			DIVIDE([D1 Retained], [Players])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Performance
		lineageTag: df99a676-8005-52d9-a177-b2006e83a335

	measure 'D7 Retention' =
			DIVIDE([D7 Retained], [Players])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Performance
		lineageTag: 7ba632b9-2d07-5b29-ba77-25afbdbe44a7

	measure 'Both Retained' =
			COALESCE(CALCULATE([Players], fact_players[retention_1] = 1, fact_players[retention_7] = 1), 0)
		formatString: #,0
		displayFolder: Performance
		lineageTag: a07270a2-d3f6-52df-a208-76e6def50446

	measure 'D7 Given D1' =
			DIVIDE([Both Retained], [D1 Retained])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Performance
		lineageTag: 7f854bcb-9f08-519d-bcd9-8b06e008bae1

	measure 'D1 Gate 30' =
			CALCULATE([D1 Retention], fact_players[version] = "gate_30")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Experiment
		lineageTag: 2b3af809-394c-51bc-805e-ab0e17bcaa26

	measure 'D1 Gate 40' =
			CALCULATE([D1 Retention], fact_players[version] = "gate_40")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Experiment
		lineageTag: 754246ab-593f-536b-af69-8201c4e39f34

	measure 'D7 Gate 30' =
			CALCULATE([D7 Retention], fact_players[version] = "gate_30")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Experiment
		lineageTag: aad524f7-887e-56eb-8c01-9343566156e2

	measure 'D7 Gate 40' =
			CALCULATE([D7 Retention], fact_players[version] = "gate_40")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Experiment
		lineageTag: ec922d89-cbdf-594f-a5bd-3e27a420574e

	measure 'D1 Difference' =
			IF(ISBLANK([D1 Gate 40]) || ISBLANK([D1 Gate 30]), BLANK(), [D1 Gate 40] - [D1 Gate 30])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Experiment
		lineageTag: c5734531-24c7-55e4-a640-19c94276ff0c

	measure 'D7 Difference' =
			IF(ISBLANK([D7 Gate 40]) || ISBLANK([D7 Gate 30]), BLANK(), [D7 Gate 40] - [D7 Gate 30])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Experiment
		lineageTag: 42aa7609-a9b9-5150-9fd4-74da0f3eaedd

	measure 'D7 Difference pp' =
			100 * [D7 Difference]
		formatString: 0.00" pp";-0.00" pp";0.00" pp"
		displayFolder: Experiment
		lineageTag: 9ee86177-de03-550e-afcd-d018f37d840b

	measure 'D1 Relative Lift' =
			DIVIDE([D1 Difference], [D1 Gate 30])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Experiment
		lineageTag: 639749c9-7385-5d30-8e38-b7dc2b83ba57

	measure 'D7 Relative Lift' =
			DIVIDE([D7 Difference], [D7 Gate 30])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Experiment
		lineageTag: 3358c15e-9ace-52f7-b188-2902debac334

	measure 'Share of Rounds' =
			DIVIDE([Total Rounds], CALCULATE([Total Rounds], ALLSELECTED(dim_tier), ALLSELECTED(dim_cohort), ALLSELECTED(dim_decile)))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Performance
		lineageTag: b0b70484-bcda-554f-bda6-c04583b9ed75

	measure 'Share of Players' =
			DIVIDE([Players], CALCULATE([Players], ALLSELECTED(dim_tier), ALLSELECTED(dim_cohort), ALLSELECTED(dim_decile)))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Performance
		lineageTag: 5be1eb3a-748e-586c-984c-9716e46a7068

	measure 'Cumulative Rounds' =
			VAR Cutoff = MAX(dim_decile[decile])
			RETURN CALCULATE([Total Rounds], FILTER(ALLSELECTED(dim_decile), dim_decile[decile] <= Cutoff))
		formatString: #,0
		displayFolder: Performance
		lineageTag: 411297b8-85a2-5aee-921d-8a7f99c77c10

	measure 'Cumulative Share' =
			DIVIDE([Cumulative Rounds], CALCULATE([Total Rounds], ALLSELECTED(dim_decile)))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Performance
		lineageTag: f10db0b1-7fc0-5702-984f-bc869e500491

	column 'userid'
		dataType: int64
		sourceColumn: userid
		summarizeBy: none
		lineageTag: f5e485f3-63c9-56dc-8363-99d5867064d3
		isHidden

	column 'version'
		dataType: string
		sourceColumn: version
		summarizeBy: none
		lineageTag: 49e22752-1f5a-51cb-bf91-91dea4c39d90

	column 'sum_gamerounds'
		dataType: int64
		sourceColumn: sum_gamerounds
		summarizeBy: none
		lineageTag: 818d6200-fa6a-56f6-8425-38545eb50a98
		isHidden

	column 'retention_1'
		dataType: int64
		sourceColumn: retention_1
		summarizeBy: none
		lineageTag: 30f4a5be-3e6c-5c56-b9ea-0e504d900d1a
		isHidden

	column 'retention_7'
		dataType: int64
		sourceColumn: retention_7
		summarizeBy: none
		lineageTag: 1562d722-01d0-5132-ad5c-8a32ca392629
		isHidden

	column 'tier_id'
		dataType: int64
		sourceColumn: tier_id
		summarizeBy: none
		lineageTag: 9edfb0ec-11b9-582b-8191-f3433db87e30
		isHidden

	column 'tier'
		dataType: string
		sourceColumn: tier
		summarizeBy: none
		lineageTag: 4d275217-2e58-5ed8-ae02-ffc2d780e132
		isHidden

	column 'cohort'
		dataType: string
		sourceColumn: cohort
		summarizeBy: none
		lineageTag: 5adb8923-ec66-5399-ae8e-bf430f830d1f
		isHidden

	column 'cohort_tier'
		dataType: string
		sourceColumn: cohort_tier
		summarizeBy: none
		lineageTag: 00073c0d-43ac-50e9-9bbe-df2d0713fc40
		isHidden

	column 'decile'
		dataType: int64
		sourceColumn: decile
		summarizeBy: none
		lineageTag: b200f285-0324-5f9f-9d71-2d03d536db66
		isHidden

	column 'secondary_segment'
		dataType: string
		sourceColumn: secondary_segment
		summarizeBy: none
		lineageTag: 7aaf6045-e090-53cb-bf63-488e40f18038
		isHidden

	partition fact_players = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), {"userid", "version", "sum_gamerounds", "retention_1", "retention_7", "tier_id", "tier", "cohort", "cohort_tier", "decile", "secondary_segment"}),
				    Typed = Table.TransformColumnTypes(Source, {{"userid", Int64.Type}, {"version", type text}, {"sum_gamerounds", Int64.Type}, {"retention_1", Int64.Type}, {"retention_7", Int64.Type}, {"tier_id", Int64.Type}, {"tier", type text}, {"cohort", type text}, {"cohort_tier", type text}, {"decile", Int64.Type}, {"secondary_segment", type text}})
				in
				    Typed
